# Required for live Gemini calls (single-key mode)
GEMINI_API_KEY=your_gemini_api_key_here

# Multi-key mode (recommended for round-robin rate-limit mitigation)
# Either JSON-like list...
GEMINI_API_KEYS=[AIza...,AIza...,AIza...]
# ...or comma-separated string
# GEMINI_API_KEYS=AIza...,AIza...,AIza...

# Optional runtime settings
DEFAULT_MODEL=gemini-3.8-flash
DEFAULT_TEMPERATURE=0.2
MAX_OUTPUT_TOKENS=1200
REQUEST_TIMEOUT_SEC=15
VISION_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-flash-latest

# YOLOv8 PCB defect detector (download trained weights to this path)
# PCB_DEFECT_MODEL_PATH=models/best.pt
